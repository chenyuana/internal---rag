# 所有宿主机持久化内容的统一根目录。Windows 路径使用正斜杠。
RAG_ROOT=D:/internal-rag
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

INGESTION_ENABLED=true
INGESTION_ROOT=D:/internal-rag/data/ingestion
INGESTION_MAX_UPLOAD_BYTES=209715200
INGESTION_WORKER_CONCURRENCY=1

# 远程解析服务保持关闭，待对应服务在内网主机启动并通过健康检查后再启用。
MINERU_ENABLED=false
MINERU_BASE_URL=http://127.0.0.1:8886
MINERU_HEALTH_PATH=/openapi.json
MINERU_TIMEOUT_SECONDS=1800
MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=auto
# 每个 /file_parse 请求处理的连续页数上限（吞吐与显存/内存峰值的权衡，8G 显存建议 10-30）
MINERU_PAGE_BATCH_SIZE=10

DOCLING_ENABLED=false
DOCLING_BASE_URL=http://127.0.0.1:5001
DOCLING_HEALTH_PATH=/openapi.json
DOCLING_TIMEOUT_SECONDS=1800
DOCLING_PARSE_METHOD=raw

# 本地图表理解；仅处理识别为 figure_review 的独立图表裁图。
FIGURE_VLM_ENABLED=false
FIGURE_VLM_BASE_URL=http://127.0.0.1:11434
FIGURE_VLM_HEALTH_PATH=/api/version
FIGURE_VLM_MODEL_NAME=qwen3.5:9b-q4_K_M
FIGURE_VLM_TIMEOUT_SECONDS=300
FIGURE_VLM_MAX_OUTPUT_TOKENS=800

POSTGRES_DB=internal_rag
POSTGRES_USER=internal_rag
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://internal_rag:change-me@postgres:5432/internal_rag

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=internal-rag
MINIO_ROOT_PASSWORD=change-me-now
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=internal-rag-documents

RAGFLOW_ENABLED=true
RAGFLOW_REQUIRED=false
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_CONTAINER_BASE_URL=http://host.docker.internal:9380
RAGFLOW_API_KEY=
RAGFLOW_HEALTH_PATH=/api/v1/system/healthz
RAGFLOW_PUBLISH_TIMEOUT_SECONDS=120
RAGFLOW_PUBLISH_BATCH_SIZE=16

ACCESS_CONTROL_MODE=development_passthrough

ANSWER_MODEL_ENABLED=true
ANSWER_MODEL_REQUIRED=false
ANSWER_MODEL_BASE_URL=http://127.0.0.1:11434/v1
ANSWER_MODEL_API_KEY=
ANSWER_MODEL_NAME=qwen3.5:9b-q4_K_M

VERIFIER_MODEL_ENABLED=true
VERIFIER_MODEL_REQUIRED=false
VERIFIER_MODEL_BASE_URL=http://127.0.0.1:11434/v1
VERIFIER_MODEL_API_KEY=
VERIFIER_MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M

EMBEDDING_MODEL_ENABLED=true
EMBEDDING_MODEL_REQUIRED=false
EMBEDDING_MODEL_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL_API_KEY=
EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b

RERANKER_MODEL_ENABLED=true
RERANKER_MODEL_REQUIRED=false
RERANKER_MODEL_BASE_URL=http://127.0.0.1:8003
RERANKER_MODEL_API_KEY=
RERANKER_MODEL_NAME=qwen3-reranker-0.6b-q8_0
RERANKER_PATH=/rerank

# 将这些缓存变量显式放到 D 盘，防止模型和构建缓存写入系统盘。
HF_HOME=D:/internal-rag/cache/huggingface
HUGGINGFACE_HUB_CACHE=D:/internal-rag/cache/huggingface/hub
TRANSFORMERS_CACHE=D:/internal-rag/cache/huggingface/transformers
TORCH_HOME=D:/internal-rag/cache/torch
PIP_CACHE_DIR=D:/internal-rag/cache/pip
UV_CACHE_DIR=D:/internal-rag/cache/uv
TEMP=D:/internal-rag/temp
TMP=D:/internal-rag/temp
